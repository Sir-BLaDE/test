{
  "name": "nuvio-search-es-priority",
  "version": "1.0.0",
  "displayName": "Nuvio Addon: Busqueda Prioritaria Castellano Espanol",
  "description": "Addon de Nuvio para optimizar busquedas priorizando contenido en castellano espanol (ES-ES y variantes latinas). Filtra italiano/frances/portugues automaticamente.",
  "category": "search",
  "priority": 1,
  "author": "Sir-BLaDE",
